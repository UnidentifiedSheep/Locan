<Project>
    <PropertyGroup>
        <LocanDefaultCulture Condition="'$(LocanDefaultCulture)' == ''">en</LocanDefaultCulture>
        <LocanUseDefaultResourceLink Condition="'$(LocanUseDefaultResourceLink)' == ''">true</LocanUseDefaultResourceLink>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <LocanResource>
            <GenerateMessages>true</GenerateMessages>
            <CopyToOutput>true</CopyToOutput>
        </LocanResource>
    </ItemDefinitionGroup>
</Project>
