<Project>
    <ItemGroup>
        <LocanResource Update="@(LocanResource->WithMetadataValue('Link', ''))"
                       Condition="'$(LocanUseDefaultResourceLink)' == 'true'">
            <Link>Locan/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </LocanResource>

        <None Remove="@(LocanResource)" />
        <AdditionalFiles Remove="@(LocanResource)" />
        <Content Remove="@(LocanResource)" />

        <AdditionalFiles Include="@(LocanResource->WithMetadataValue('GenerateMessages', 'true'))" />

        <Content Include="@(LocanResource->WithMetadataValue('CopyToOutput', 'true'))">
            <TargetPath>Locan/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>

        <CompilerVisibleProperty Include="LocanDefaultCulture" />
    </ItemGroup>
</Project>
