<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <RootNamespace>Locan.Generator</RootNamespace>
        <PackageId>Locan.Generator</PackageId>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackLocanGeneratorAssemblies
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\Locan.Core\Locan.Core.csproj" />
        <ProjectReference Include="..\..\..\Locan.Build\Locan.Build.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"
                          AdditionalProperties="TargetFramework=net10.0"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\Locan.Build\buildTransitive\Locan.Build.targets"
              Pack="true"
              PackagePath="buildTransitive\Locan.Generator.targets" />
    </ItemGroup>

    <Target Name="PackLocanGeneratorAssemblies">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetPath)"
                                    PackagePath="analyzers\dotnet\cs" />
            <TfmSpecificPackageFile Include="$(TargetDir)Locan.Core.dll"
                                    PackagePath="analyzers\dotnet\cs" />
            <TfmSpecificPackageFile Include="..\..\..\Locan.Build\bin\$(Configuration)\net10.0\Locan.Build.dll"
                                    PackagePath="tools\net10.0" />
            <TfmSpecificPackageFile Include="..\..\..\Locan.Build\bin\$(Configuration)\net10.0\Locan.Compiler.dll"
                                    PackagePath="tools\net10.0" />
        </ItemGroup>
    </Target>

</Project>
