<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Locan.Generator\buildTransitive\Locan.Generator.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>Locan.Generator.Sample</RootNamespace>
        <IsPackable>false</IsPackable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <LocanDefaultCulture>en</LocanDefaultCulture>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Locan.Generator\Locan.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\..\..\Locan.Core\Locan.Core.csproj" />
        <ProjectReference Include="..\..\..\..\Locan\Locan.csproj" />
    </ItemGroup>

	<ItemGroup>
		<Analyzer Include="..\..\..\..\Locan.Core\bin\$(Configuration)\netstandard2.0\Locan.Core.dll" />
	</ItemGroup>

    <ItemGroup>
        <LocanResource Include="article-*.json"
                       GenerateMessages="true"
                       CopyToOutput="true" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="DDD.UbiquitousLanguageRegistry.txt"/>
    </ItemGroup>

    <Import Project="..\Locan.Generator\buildTransitive\Locan.Generator.targets" />

</Project>
