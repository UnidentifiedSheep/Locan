<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>Locan.Generator.Sample</RootNamespace>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <LocanBuildTaskAssembly>$(MSBuildProjectDirectory)/../../../Locan.Build/bin/$(Configuration)/netstandard2.0/Locan.Build.dll</LocanBuildTaskAssembly>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Locan.Generator\Locan.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\..\..\Locan.Core\Locan.Core.csproj" />
        <ProjectReference Include="..\..\..\..\Locan\Locan.csproj" />
    </ItemGroup>

	<ItemGroup>
		<Analyzer Include="..\..\..\..\Locan.Core\bin\$(Configuration)\netstandard2.0\Locan.Core.dll" />
	</ItemGroup>

    <ItemGroup>
        <None Remove="DDD.UbiquitousLanguageRegistry.txt"/>
    </ItemGroup>

    <Import Project="..\..\..\Locan.Build\buildTransitive\Locan.Build.targets" />

</Project>
