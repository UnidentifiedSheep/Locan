<Project>
    <PropertyGroup>
        <LocanConfigPath Condition="'$(LocanConfigPath)' == ''">$(MSBuildProjectDirectory)/localizationSettings.json</LocanConfigPath>
    </PropertyGroup>

    <UsingTask
        TaskName="Locan.Build.Build.ResolveLocalizationFiles"
        AssemblyFile="$(MSBuildThisFileDirectory)../tools/net10.0/Locan.Build.dll" />

    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="TargetPath" />
    </ItemGroup>

    <Target
        Name="ResolveLocanLocalizationFiles"
        BeforeTargets="AssignTargetPaths;GenerateMSBuildEditorConfigFile;CoreCompile"
        Condition="Exists('$(LocanConfigPath)')">
        <ResolveLocalizationFiles ConfigPath="$(LocanConfigPath)">
            <Output TaskParameter="Files" ItemName="_LocanLocalizationFiles" />
            <Output TaskParameter="TemplateFiles" ItemName="_LocanLocalizationTemplateFiles" />
        </ResolveLocalizationFiles>

        <ItemGroup>
            <Content Include="@(_LocanLocalizationFiles)">
                <TargetPath>%(_LocanLocalizationFiles.TargetPath)</TargetPath>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </Content>

            <AdditionalFiles Include="@(_LocanLocalizationTemplateFiles)">
                <TargetPath>%(_LocanLocalizationTemplateFiles.TargetPath)</TargetPath>
            </AdditionalFiles>
        </ItemGroup>
    </Target>
</Project>
