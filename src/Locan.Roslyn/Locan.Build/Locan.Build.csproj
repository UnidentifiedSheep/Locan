<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackLocanBuildTaskAssemblies
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.10.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Locan.Compiler\Locan.Compiler.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <None Include="buildTransitive\Locan.Build.targets"
            Pack="true"
            PackagePath="buildTransitive\Locan.Build.targets" />
    </ItemGroup>

    <Target Name="PackLocanBuildTaskAssemblies">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetDir)Locan.Build.dll"
                                    PackagePath="tools\$(TargetFramework)\" />
            <TfmSpecificPackageFile Include="$(TargetDir)Locan.Compiler.dll"
                                    PackagePath="tools\$(TargetFramework)\" />
        </ItemGroup>
    </Target>

</Project>
