<Project>
    <PropertyGroup>
        <Authors>Diyar Tashliyan</Authors>
        <Copyright>Copyright © 2026 Diyar Tashliyan</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/UnidentifiedSheep/Locan</PackageProjectUrl>
        <RepositoryUrl>https://github.com/UnidentifiedSheep/Locan.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>localization;internationalization;i18n;dotnet</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md"
              Pack="true"
              PackagePath="\"
              Link="README.md"
              Visible="false" />
    </ItemGroup>
</Project>
